server {
    listen 80;
    listen [::]:80;
    server_name andrewflanigan.com www.andrewflanigan.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name andrewflanigan.com www.andrewflanigan.com;

    ssl_certificate /etc/letsencrypt/live/andrewflanigan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/andrewflanigan.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/andrewflanigan.com;
    index index.html;

    gzip_static on;

    location / {
        try_files $uri $uri/ =404;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}