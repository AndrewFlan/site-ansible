# Initial HTTP config — Certbot will modify this file
# to add HTTPS and the HTTP→HTTPS redirect automatically
server {
    listen 80;
    listen [::]:80;

    server_name andrewflanigan.com www.andrewflanigan.com;

    root /var/www/andrewflanigan.com;
    index index.html;

    # Serve pre-compressed .gz files from Hugo if available
    gzip_static on;

    location / {
        try_files $uri $uri/ =404;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Cache static assets aggressively
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
